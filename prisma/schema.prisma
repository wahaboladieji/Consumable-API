// Prisma schema for Consumable API
// Governance: PRD §5, database-schema.md, AGENTS.md §2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id              String     @id @default(uuid())
  name            String     @db.VarChar(120)
  slug            String     @unique @db.VarChar(140)
  cuisine         String     @db.VarChar(40)
  address         String     @db.VarChar(200)
  city            String     @db.VarChar(60)
  rating          Decimal    @db.Decimal(2, 1)
  deliveryFeeKobo BigInt     @map("delivery_fee_kobo")
  isOpen          Boolean    @default(true) @map("is_open")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  menuItems       MenuItem[]
  orders          Order[]

  @@index([city, cuisine])
  @@index([rating(sort: Desc), id])
  @@index([deliveryFeeKobo, id])
  @@map("restaurants")
}

model MenuItem {
  id           String      @id @default(uuid())
  restaurantId String      @map("restaurant_id")
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String      @db.VarChar(120)
  description  String?     @db.Text
  category     String      @db.VarChar(40)
  priceKobo    BigInt      @map("price_kobo")
  isAvailable  Boolean     @default(true) @map("is_available")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  orderItems   OrderItem[]

  @@index([restaurantId, category])
  @@index([priceKobo, id])
  @@map("menu_items")
}

model Customer {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name") @db.VarChar(120)
  email     String   @unique @db.VarChar(160)
  phone     String   @db.VarChar(20)
  city      String   @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders    Order[]

  @@map("customers")
}

model Order {
  id              String      @id @default(uuid())
  customerId      String      @map("customer_id")
  customer        Customer    @relation(fields: [customerId], references: [id])
  restaurantId    String      @map("restaurant_id")
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id])
  status          String      @default("pending") @db.VarChar(20)
  subtotalKobo    BigInt      @map("subtotal_kobo")
  deliveryFeeKobo BigInt      @map("delivery_fee_kobo")
  totalKobo       BigInt      @map("total_kobo")
  deliveryAddress String      @map("delivery_address") @db.VarChar(200)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  items           OrderItem[]

  @@index([customerId, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String   @map("order_id")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId    String   @map("menu_item_id")
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id])
  nameAtOrder   String   @map("name_at_order") @db.VarChar(120)
  unitPriceKobo BigInt   @map("unit_price_kobo")
  quantity      Int

  @@index([orderId])
  @@map("order_items")
}
